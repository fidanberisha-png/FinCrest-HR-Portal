# Postgres connection string from Neon (include ?sslmode=require)
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Random string, 32+ characters, used to sign auth cookies
JWT_SECRET="change-me-to-a-long-random-string"

# Email (Gmail App Password or Resend SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="hr@yourcompany.com"
SMTP_PASS="your-app-password"
SMTP_FROM="FinCrest HR <hr@yourcompany.com>"

# Random string used by the GitHub Actions backup workflow
BACKUP_TOKEN="change-me-too"

# Optional: public base URL of the deployed app (used in email links)
APP_URL="https://fincrest-hr-portal.onrender.com"
